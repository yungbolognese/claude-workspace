# Copy to .env and fill in. Load with: set -a; source .env; set +a

DPG_DB_PATH=data/gateway.db
DPG_HOST=127.0.0.1
DPG_PORT=8080
# Public HTTPS URL Twilio calls (e.g. Tailscale Funnel); used to verify signatures
DPG_PUBLIC_BASE_URL=https://mac-mini.your-tailnet.ts.net

DPG_TWILIO_ACCOUNT_SID=
DPG_TWILIO_AUTH_TOKEN=
DPG_TWILIO_FROM_NUMBER=+15550000000

# mock | uber_guest
DPG_RIDE_PROVIDER=mock
# none | nominatim  (uber_guest needs nominatim for coordinates)
DPG_GEOCODER=none
DPG_GEOCODER_COUNTRIES=us

# Uber for Business Guest Rides (only if DPG_RIDE_PROVIDER=uber_guest)
DPG_UBER_CLIENT_ID=
DPG_UBER_CLIENT_SECRET=
DPG_UBER_SANDBOX=1
DPG_UBER_SANDBOX_RUN_ID=

# Optional: free-text understanding with local Ollama
DPG_LLM_FALLBACK=0
DPG_OLLAMA_MODEL=qwen2.5:7b

DPG_ALLOW_OPEN_SIGNUP=0
DPG_LOG_MESSAGES=0
